{
  "name": "quizatz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server,storage -c cyan,yellow,magenta \"npm:dev:web\" \"npm:dev:server\" \"npm:storage\"",
    "dev:web": "vite",
    "dev:server": "wait-on tcp:127.0.0.1:10002 && tsx watch --env-file=.env server/index.ts",
    "typecheck": "vue-tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "build:server": "tsc --project tsconfig.server.json",
    "build": "npm run typecheck && vite build && npm run build:server",
    "start": "node dist-server/server/index.js",
    "test:e2e": "playwright test",
    "storage": "azurite-table --silent --location .azurite"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.13.2",
    "@azure/msal-browser": "5.19.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@lucide/vue": "1.33.0",
    "jose": "6.2.9",
    "vue": "3.5.41",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.19.11",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "6.0.8",
    "azurite": "^3.35.0",
    "concurrently": "10.0.5",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vue-tsc": "3.1.1",
    "wait-on": "^9.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
