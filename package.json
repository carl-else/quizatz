{
  "name": "quizatz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,party -c cyan,yellow \"npm:dev:web\" \"npm:dev:party\"",
    "dev:web": "vite",
    "dev:party": "partykit dev",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:e2e": "playwright test",
    "deploy:party": "partykit deploy"
  },
  "dependencies": {
    "@azure/msal-browser": "5.19.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@lucide/vue": "1.33.0",
    "jose": "6.2.9",
    "partysocket": "1.3.0",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "concurrently": "10.0.5",
    "partykit": "0.0.115",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vue-tsc": "3.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
